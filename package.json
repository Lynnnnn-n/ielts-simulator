{
  "name": "ielts-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "predeploy": "pnpm build --mode github-pages && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "gh-pages": "^6.3.0"
  }
}
